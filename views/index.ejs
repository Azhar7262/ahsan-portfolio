<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= content.seo.title %></title>
  <meta name="description" content="<%= content.seo.description %>" />
  <link rel="canonical" href="<%= siteUrl %>" />

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="profile" />
  <meta property="og:title" content="<%= content.seo.title %>" />
  <meta property="og:description" content="<%= content.seo.description %>" />
  <meta property="og:url" content="<%= siteUrl %>" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= content.seo.title %>" />
  <meta name="twitter:description" content="<%= content.seo.description %>" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🖥️</text></svg>" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- ===== Sticky Nav ===== -->
  <header class="nav-wrap">
    <nav class="nav container" aria-label="Main navigation">
      <a class="nav-logo" href="#home"><span class="mono">&lt;</span>AI<span class="mono">/&gt;</span></a>
      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="#about">About</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#education">Education</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a class="btn btn-primary btn-sm" href="/cv" data-cv-track>Download CV</a></li>
      </ul>
    </nav>
  </header>

  <main id="main">
    <!-- ===== Hero ===== -->
    <section class="hero" id="home">
      <div class="container hero-grid">
        <div class="hero-text">
          <p class="mono hero-kicker">// <%= content.location %></p>
          <h1><%= content.name %></h1>
          <p class="hero-title"><%= content.title %></p>
          <p class="hero-tagline"><%= content.tagline %></p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="/cv" data-cv-track>⬇ Download CV</a>
            <a class="btn btn-secondary" href="#contact">Contact Me</a>
            <% if (content.contact.whatsapp) { %>
              <a class="btn btn-ghost" href="https://wa.me/<%= content.contact.whatsapp %>" target="_blank" rel="noopener">WhatsApp</a>
            <% } %>
          </div>
        </div>
        <div class="hero-photo" aria-hidden="true">
          <div class="photo-frame">
            <span class="mono photo-placeholder">photo.jpg</span>
            <p class="photo-note">Professional headshot goes here</p>
          </div>
          <!-- Replace this block with: <img src="/images/profile.jpg" alt="Portrait of Ahsan Ilyas" width="280" height="280"> -->
        </div>
      </div>
      <div class="container">
        <ul class="stats-strip">
          <% content.stats.forEach(s => { %>
            <li><strong><%= s.value %></strong><span><%= s.label %></span></li>
          <% }) %>
        </ul>
      </div>
    </section>

    <!-- ===== About ===== -->
    <section class="section" id="about">
      <div class="container">
        <p class="mono section-kicker">01. About</p>
        <h2>About Me</h2>
        <% content.about.forEach(p => { %><p class="about-p"><%= p %></p><% }) %>
        <p class="about-looking"><strong>What I'm looking for:</strong> <%= content.lookingFor %></p>
        <div class="quick-facts">
          <div><span class="fact-label mono">location</span><span><%= content.location %></span></div>
          <div><span class="fact-label mono">languages</span><span><%= content.languages %></span></div>
          <div><span class="fact-label mono">interests</span><span><%= content.interests %></span></div>
        </div>
      </div>
    </section>

    <!-- ===== Skills ===== -->
    <section class="section section-alt" id="skills">
      <div class="container">
        <p class="mono section-kicker">02. Skills</p>
        <h2>Skills &amp; Expertise</h2>
        <div class="skills-grid">
          <% content.skills.forEach(group => { %>
            <div class="skill-card">
              <h3><%= group.category %></h3>
              <ul class="chips">
                <% group.items.forEach(item => { %><li class="chip"><%= item %></li><% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ===== Experience ===== -->
    <section class="section" id="experience">
      <div class="container">
        <p class="mono section-kicker">03. Experience</p>
        <h2>Where I've Worked</h2>
        <ol class="timeline">
          <% content.experience.forEach(job => { %>
            <li class="timeline-item">
              <div class="timeline-dot" aria-hidden="true"></div>
              <p class="mono timeline-period"><%= job.period %></p>
              <h3><%= job.role %> <span class="timeline-company">· <%= job.company %></span></h3>
              <ul>
                <% job.bullets.forEach(b => { %><li><%= b %></li><% }) %>
              </ul>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>

    <!-- ===== Education ===== -->
    <section class="section section-alt" id="education">
      <div class="container">
        <p class="mono section-kicker">04. Education</p>
        <h2>Education</h2>
        <div class="edu-grid">
          <% content.education.forEach(edu => { %>
            <div class="edu-card">
              <h3><%= edu.qualification %></h3>
              <p><%= edu.institution %> <span class="mono edu-period">· <%= edu.period %></span></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ===== Contact ===== -->
    <section class="section" id="contact">
      <div class="container">
        <p class="mono section-kicker">05. Contact</p>
        <h2>Get In Touch</h2>
        <p class="contact-lede">Looking for reliable IT support or have an opportunity in mind? Let's talk.</p>

        <div class="contact-grid">
          <div class="contact-info">
            <ul class="contact-links">
              <li><a href="mailto:<%= content.contact.email %>" class="email-obfuscated" data-user="<%= content.contact.email.split('@')[0] %>" data-domain="<%= content.contact.email.split('@')[1] %>">✉ Email</a></li>
              <% if (content.contact.phone) { %>
                <li><a href="tel:<%= content.contact.phone.replace(/\s/g, '') %>">📞 <%= content.contact.phone %></a></li>
              <% } %>
              <% if (content.contact.whatsapp) { %>
                <li><a href="https://wa.me/<%= content.contact.whatsapp %>" target="_blank" rel="noopener">💬 WhatsApp chat</a></li>
              <% } %>
              <% if (content.contact.linkedin) { %>
                <li><a href="<%= content.contact.linkedin %>" target="_blank" rel="noopener">in LinkedIn</a></li>
              <% } %>
            </ul>
            <p class="contact-privacy">Prefer the form? It's the fastest way to reach me. Your details are only used to reply to your message.</p>
          </div>

          <form class="contact-form" method="POST" action="/contact" novalidate>
            <!-- honeypot: hidden from humans -->
            <input type="text" name="website" id="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="form-row">
              <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" required minlength="2" placeholder="Your name" />
              </div>
              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required placeholder="you@example.com" />
              </div>
            </div>
            <div class="form-group">
              <label for="subject">Subject *</label>
              <select id="subject" name="subject" required>
                <% content.contact.subjects.forEach(s => { %>
                  <option value="<%= s %>"><%= s %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label for="message">Message *</label>
              <textarea id="message" name="message" rows="5" required minlength="10" placeholder="Tell me what you need…"></textarea>
            </div>

            <% if (submitted) { %>
              <p class="alert alert-success" role="status">✓ Message sent — I'll get back to you soon!</p>
            <% } %>
            <% if (formError) { %>
              <p class="alert alert-error" role="alert">✗ Please fill in all required fields (message needs at least 10 characters).</p>
            <% } %>

            <button class="btn btn-primary btn-block" type="submit">Send Message</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- ===== Footer ===== -->
  <footer class="footer">
    <div class="container footer-inner">
      <p>© <%= new Date().getFullYear() %> <%= content.name %>. Built with Node.js.</p>
      <ul class="footer-links">
        <li><a href="#about">About</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="/cv" data-cv-track>CV</a></li>
      </ul>
      <a class="back-to-top" href="#home" aria-label="Back to top">↑</a>
    </div>
  </footer>

  <!-- JSON-LD structured data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "<%= content.name %>",
    "jobTitle": "<%= content.title %>",
    "email": "mailto:<%= content.contact.email %>",
    "telephone": "<%= content.contact.phone %>",
    "address": { "@type": "PostalAddress", "addressLocality": "Islamabad", "addressCountry": "PK" },
    "alumniOf": ["Capital University of Science and Technology", "Punjab College of Information Technology"],
    "knowsLanguage": ["English", "Urdu"],
    "url": "<%= siteUrl %>"
  }
  </script>

  <script src="/js/main.js"></script>
</body>
</html>
